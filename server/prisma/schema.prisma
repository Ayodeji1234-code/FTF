generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
}

enum UserRole {
  ADMIN
  STAFF
}

enum ApplicationStatus {
  PENDING
  APPROVED
  REJECTED
}

enum DonationStatus {
  PENDING
  SUCCESSFUL
  FAILED
}

model User {
  id           String   @id @default(cuid())
  name         String
  email        String   @unique
  passwordHash String
  role         UserRole @default(STAFF)
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt
}

model ContactMessage {
  id        String   @id @default(cuid())
  name      String
  email     String
  phone     String?
  subject   String?
  message   String
  createdAt DateTime @default(now())

  @@index([email])
  @@index([createdAt])
}

model VolunteerApplication {
  id          String            @id @default(cuid())
  name        String
  email       String
  phone       String?
  area        String
  motivation  String?
  status      ApplicationStatus @default(PENDING)
  createdAt   DateTime          @default(now())
  updatedAt   DateTime          @updatedAt

  @@index([email])
  @@index([status])
}

model PartnerApplication {
  id          String            @id @default(cuid())
  organizationName String
  contactName String
  email       String
  phone       String?
  message     String?
  status      ApplicationStatus @default(PENDING)
  createdAt   DateTime          @default(now())
  updatedAt   DateTime          @updatedAt

  @@index([email])
  @@index([status])
}

model Donation {
  id          String         @id @default(cuid())
  donorName   String?
  donorEmail  String?
  amount      Decimal        @db.Decimal(12, 2)
  currency    String         @default("NGN")
  reference   String         @unique
  status      DonationStatus @default(PENDING)
  createdAt   DateTime       @default(now())
  updatedAt   DateTime       @updatedAt

  @@index([donorEmail])
  @@index([status])
}

model NewsletterSubscriber {
  id        String   @id @default(cuid())
  email     String   @unique
  createdAt DateTime @default(now())
}